// -------- gap-агрегаторы: Σ g_j * p_j --------

glin1(clock, p1, g1) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1;
    return this.r;
}

glin2(clock, p1, p2, g1, g2) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1 + g2 * p2;
    return this.r;
}

glin3(clock, p1, p2, p3, g1, g2, g3) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1 + g2 * p2 + g3 * p3;
    return this.r;
}

glin4(clock, p1, p2, p3, p4, g1, g2, g3, g4) {
