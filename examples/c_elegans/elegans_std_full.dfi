    this.r = g1 * p1 + g2 * p2 + g3 * p3 + g4 * p4 + g5 * p5 + g6 * p6 + g7 * p7 + g8 * p8 + g9 * p9 +
            g10 * p10 + g11 * p11 + g12 * p12 + g13 * p13;
    return this.r;
}

glin14(clock, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1 + g2 * p2 + g3 * p3 + g4 * p4 + g5 * p5 + g6 * p6 + g7 * p7 + g8 * p8 + g9 * p9 +
            g10 * p10 + g11 * p11 + g12 * p12 + g13 * p13 + g14 * p14;
    return this.r;
}

glin15(clock, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1 + g2 * p2 + g3 * p3 + g4 * p4 + g5 * p5 + g6 * p6 + g7 * p7 + g8 * p8 + g9 * p9 +
            g10 * p10 + g11 * p11 + g12 * p12 + g13 * p13 + g14 * p14 + g15 * p15;
    return this.r;
}

glin16(clock, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15, g16) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = g1 * p1 + g2 * p2 + g3 * p3 + g4 * p4 + g5 * p5 + g6 * p6 + g7 * p7 + g8 * p8 + g9 * p9 +
            g10 * p10 + g11 * p11 + g12 * p12 + g13 * p13 + g14 * p14 + g15 * p15 + g16 * p16;
    return this.r;
}

// -------- neurons / sensors / muscles (arities for data) --------

// neuron0: 0 dendrites
neuron0(clock, tau, bias, seed) {
    if(clock == undefined) return 0.;
    if(this.v == undefined) { this.v = bias; this.t = clock; this.s = seed; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.v;
    if(this.s == 0.) this.s = 1.;
    this.s ^= this.s << 13; this.s ^= this.s >> 7; this.s ^= this.s << 17;
    u = bias + (u01(this.s) - .5) * 0.1;
    k = dt / tau;
    if(k > .5) k = .5;
    this.v += (u - this.v) * k;
    return this.v;
}

// neuron0G: 0 dendrites + gap
neuron0G(clock, gapagg, gsum, tau, bias, seed) {
    if(clock == undefined) return 0.;
    if(this.v == undefined) { this.v = bias; this.t = clock; this.s = seed; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.v;
    if(this.s == 0.) this.s = 1.;
    this.s ^= this.s << 13; this.s ^= this.s >> 7; this.s ^= this.s << 17;
    u = bias + (u01(this.s) - .5) * 0.1 + (gapagg == undefined ? 0. : gapagg - gsum * this.v);
    k = dt / tau;
    if(k > .5) k = .5;
    this.v += (u - this.v) * k;
    return this.v;
}

// muscle0G: 0 dendrites + gap
muscle0G(clock, gapagg, gsum, tau) {
    if(clock == undefined) return 0.;
    if(this.f == undefined) { this.f = 0.; this.t = clock; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.f;
    u = (gapagg == undefined ? 0. : gapagg - gsum * this.f);
    k = dt / tau;
    if(k > .5) k = .5;
    this.f += (u - this.f) * k;
    return this.f;
}

// neuron1: 1 dendrite
neuron1(clock, d1, tau, bias, seed) {
    if(clock == undefined) return 0.;
    if(this.v == undefined) { this.v = bias; this.t = clock; this.s = seed; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.v;
    if(this.s == 0.) this.s = 1.;
    this.s ^= this.s << 13; this.s ^= this.s >> 7; this.s ^= this.s << 17;
    u = d1 + bias + (u01(this.s) - .5) * 0.1;
    k = dt / tau;
    if(k > .5) k = .5;
    this.v += (u - this.v) * k;
    return this.v;
}

// muscle1: 1 dendrite
muscle1(clock, d1, tau) {
    if(clock == undefined) return 0.;
    if(this.f == undefined) { this.f = 0.; this.t = clock; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.f;
    u = d1;
    k = dt / tau;
    if(k > .5) k = .5;
    this.f += (u - this.f) * k;
    return this.f;
}

// neuron1G: 1 dendrite + gap
neuron1G(clock, d1, gapagg, gsum, tau, bias, seed) {
    if(clock == undefined) return 0.;
    if(this.v == undefined) { this.v = bias; this.t = clock; this.s = seed; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.v;
    if(this.s == 0.) this.s = 1.;
    this.s ^= this.s << 13; this.s ^= this.s >> 7; this.s ^= this.s << 17;
    u = d1 + bias + (u01(this.s) - .5) * 0.1 + (gapagg == undefined ? 0. : gapagg - gsum * this.v);
    k = dt / tau;
    if(k > .5) k = .5;
    this.v += (u - this.v) * k;
    return this.v;
}

// muscle1G: 1 dendrite + gap
muscle1G(clock, d1, gapagg, gsum, tau) {
    if(clock == undefined) return 0.;
    if(this.f == undefined) { this.f = 0.; this.t = clock; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.f;
    u = d1 + (gapagg == undefined ? 0. : gapagg - gsum * this.f);
    k = dt / tau;
    if(k > .5) k = .5;
    this.f += (u - this.f) * k;
    return this.f;
}

// sensorn1G: 1 dendrite + gap + stimulus
sensorn1G(clock, d1, gapagg, gsum, stim, gain, tau, bias, seed) {
    if(clock == undefined) return 0.;
    if(this.v == undefined) { this.v = bias; this.t = clock; this.s = seed; }
    dt = clock - this.t;
    this.t = clock;
    if(dt <= 0.) return this.v;
    if(this.s == 0.) this.s = 1.;
    this.s ^= this.s << 13; this.s ^= this.s >> 7; this.s ^= this.s << 17;
    u = (stim == undefined ? 0. : stim * gain) + d1 + bias + (u01(this.s) - .5) * 0.1 + (gapagg == undefined ? 0. : gapagg - gsum * this.v);
    k = dt / tau;
    if(k > .5) k = .5;
    this.v += (u - this.v) * k;
    return this.v;
}

