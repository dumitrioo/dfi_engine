// =============================================================================
// elegans_std_full — standard library for the FULL connectome
// C. elegans (hermaphrodite, 302 neurons + 148 targets, Cook et al. 2019)
//
// Descriptor arities are inferred from the data.
// Conventions: chemistry weight = count/40 (see elegans_connectome.txt header),
// gap conductance = count/100, -1 sign for GABAergic
// (DD, VD, RME, AVL, DVB, RIS), spike threshold 1.0.
//
// Layers:
// dsumN — dendritic aggregator: weighted sum of graded spikes
// (memoized per clock tick)
// glinN — linear gap aggregator: Σ g_j * p_j
// neuron* — neuron: (Σ dendrites) + bias + noise + gapagg - G*v, leakage to u
// sensorn* — nose sensor: neuron + stimulus input stim*gain
// muscle* — muscle/target: leakage to (Σ dendrites + gapagg - G*f)
// simtime/random_touch/first_defined/monitor — from nose_touch (tested)
// =====================================================================

// -------- pure functions --------
function rel(x, thr) { return sigmoid(x, 5.0, thr); }
function u01(x)      { return ((f64)(x >> 11) + .5) / 9007199254740992.; }

// -------- time --------
simtime(speed) {
    if(this.real == undefined) {
        set_cycle_sleep_seconds(.001);
        this.real = steady_clock();
        this.t = 0.;
    }
    now = steady_clock();
    dt = (now - this.real) * speed;
    this.real = now;
    if(dt < 0.) dt = 0.;
    this.t += dt;
    return this.t;
}

// -------- autonomous stimulus (hostless interpreter) --------
random_touch() {
    if(!this.initialized) {
        dt = randf();
        this.exp_time = steady_clock() + dt;
        this.force = randf();
        this.initialized = true;
        console.println("========== touch nose ", this.force, " for ", dt, " s.");
    }
    if(this.force > 0.) {
        if(steady_clock() > this.exp_time) {
             this.force = 0.;
             this.exp_time = steady_clock() + (randf() + 1) * 5.0;
             console.println("----------- untouch nose! ----------");
        }
    } else if(steady_clock() > this.exp_time) {
         dt = randf();
         this.exp_time = steady_clock() + dt;
         this.force = randf();
         console.println("========== touch nose ", this.force, " for ", dt, " s.");
    }
    emit this.force;
    delay(0.01);
}

first_defined(a, b) return a == undefined ? b : a;

// -------- monitor --------
monitor(clock, label, val) {
    println(label, " = ", val);
    delay(.25);
}
// -------- dendritic aggregators: chemistry (weighted emission) --------

dsum1(clock, c1, w1, thr) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = w1 * rel(c1, thr);
    return this.r;
}

dsum2(clock, c1, c2, w1, w2, thr) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = w1 * rel(c1, thr) + w2 * rel(c2, thr);
    return this.r;
}

dsum3(clock, c1, c2, c3, w1, w2, w3, thr) {
    if(clock == undefined) return 0.;
    if(this.t == clock) return this.r;
    this.t = clock;
    this.r = w1 * rel(c1, thr) + w2 * rel(c2, thr) + w3 * rel(c3, thr);
    return this.r;
}

dsum4(clock, c1, c2, c3, c4, w1, w2, w3, w4, thr) {
    if(clock == undefined) return 0.;
