    this.r = g1 * p1 + g2 * p2 + g3 * p3 + g4 * p4 + g5 * p5 + g6 * p6 + g7 * p7 + g8 * p8 + g9 * p9 +
            g10 * p10;
    return this.r;
}

glin11(clock, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11) {
