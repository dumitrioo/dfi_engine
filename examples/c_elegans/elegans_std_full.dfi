}

glin13(clock, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13) {
    if(clock == undefined) return 0.;
