// =====================================================================
//  nose_touch — рефлекс отдёргивания от касания носа
//  Схема по Kaplan & Horvitz 1993; все счётчики синапсов — точные,
//  из White et al. 1986 (openworm/CElegansNeuroML, herm_full_edgelist.csv,
//  суммы по билатеральным парам):
//
//  'touch' ─→ ASH ─┬─→ AIB ─(−34)─┐
//                  ├─→ AVB ←──────┘────(gj 15)──→ DB1     [прямой ход: гасим]
//                  ├─→ AVA ⇄(gj 66) AVD ──(167)──→ AVA
//                  └─→ AVE ──(67)──→ AVA
//  'touch' ─→ FLP ──┬─→ AVA(114) AVD(97) AVE(28)
//                   ├─(5)→ VA1                      сенсор прямо в мотор!
//                   └⇄(gj 5) DA1                    и сюда тоже
//  AVA(8)+AVD(9)+AVE(22) ──→ DA1 ──НМП 37──→ m_dorsal  'export'
//  AVA(2)+AVE(17)+FLP(5) ──→ VA1 ──НМП 18──→ m_ventral 'export'
//
//  12 «клеток» + 17 химических синапсов + 5 щелевых (10 узлов gj)
//  + часы + осциллограф = 41 узел.
//  Порядок объявлений не важен: всё форвард-декларировано, а циклы
//  (AVA↔AVD↔gj, FLP↔DA1) в статическом DFG разрешены.
// =====================================================================

'touch' host_touch;                // хост: интенсивность касания носа [0..1]

random_touch() {
    println("<-------- untouch");
    emit(0.0);
    delay((randf() + 1.) * 3.);
    println("touch -------->");
    emit(randf());
    delay(randf());
}
random_touch rnd_touch();

first_defined(a, b) return a == undefined ? b : a;
first_defined touch(host_touch, rnd_touch);


simtime simt(1.);             // реальное время; 10. — ускорить в 10 раз

// --- сенсорика: пара из тройки K&H-1993 ------------------------------
// OLQ из той тройки в коннектоме White даёт на командные нейроны
// всего ДВА синапса (OLQVL→AVAL 1, OLQVL→AVDR 1) — учебник говорит
// «важен», коннектом говорит «почти нет». Опущен; добавляется одной
// строкой mechanosensor olq(...) + syn s_olq_ava(olq, 1.);
mechanosensor ash(simt, touch, 8., 0.010, -2.5, 0.35, 88172645463325252);
mechanosensor flp(simt, touch, 5., 0.012, -2.8, 0.30, 145270282774887471);

// --- интернейроны ------------------------------------------------------
nrn5 ava(simt, s_ash_ava, s_flp_ava, s_avd_ava, s_ave_ava, gj_avd2ava,
         0.050, -3.0, 0.40, 271828182845904523);   // командный «назад»
nrn3 avd(simt, s_ash_avd, s_flp_avd, gj_ava2avd,
         0.040, -2.6, 0.40, 3141592653589793238);
nrn2 ave(simt, s_ash_ave, s_flp_ave,
         0.045, -2.8, 0.40, 1414213562373095048);
nrn2 avb(simt, s_ash_avb, s_aib_avb,
         0.045, -0.8, 0.35, 1732050807568877293);  // командный «вперёд»
nrn1 aib(simt, s_ash_aib,
         0.030, -2.2, 0.35, 9614208415436574595);  // AIB гасит AVB

// --- мотонейроны: A-класс (реверс), B-класс (вперёд) --------------------
nrn4 da1(simt, s_ava_da1, s_avd_da1, s_ave_da1, gj_ava2da1,
         0.020, -1.8, 0.30, 299792458);            // спинной, реверс
nrn4 va1(simt, s_ava_va1, s_ave_va1, s_flp_va1, gj_ava2va1,
         0.020, -1.8, 0.30, 66260695772965999);    // брюшной, реверс
nrn1 db1(simt, gj_avb2db1,
         0.020, -1.0, 0.30, 1123581321);           // спинной, вперёд

// --- мышцы: скаляр сокращения — хосту ------------------------------------
muscle m_dorsal(simt, da1, 37., 0.060, -1.6, 0.20, 1836311903) 'export';
muscle m_ventral(simt, va1, 18., 0.060, -1.6, 0.20, 5294867291847361) 'export';

// --- химические синапсы: w = счёт синапсов White1986 (L+R) ---------------
syn    s_ash_ava(ash, 26.);    // 15+1+10
syn    s_ash_avd(ash, 56.);    // 7+20+27+2
syn    s_ash_ave(ash, 7.);     // только ASHR→AVER
syn    s_ash_avb(ash, -20.);   // 14+6; знак — модельный выбор
mnsyn  s_ash_aib(ash, 20.);    // 13+7
syn    s_flp_ava(flp, 114.);   // 33+48+23+10 — монстр
syn    s_flp_avd(flp, 97.);    // 30+34+25+8
syn    s_flp_ave(flp, 28.);    // 21+7
mnsyn  s_flp_va1(flp, 5.);     // FLPL→VA01
syn    s_aib_avb(aib, -34.);   // 21+13; знак — модельный выбор
syn    s_avd_ava(avd, 167.);   // 37+37+41+52 — ГЛАВНЫЙ драйвер AVA
syn    s_ave_ava(ave, 67.);    // 17+3+14+33
mnsyn  s_ava_da1(ava, 8.);     // 6+2
mnsyn  s_avd_da1(avd, 9.);     // 4+5
mnsyn  s_ave_da1(ave, 22.);    // 11+11
mnsyn  s_ava_va1(ava, 2.);
mnsyn  s_ave_va1(ave, 17.);    // 12+5

// --- щелевые соединения: по два узла на соединение ------------------------
gj gj_avd2ava(ava, avd, 66.);   // AVA↔AVD: (7+9+2+15)·2 — ядро реверса
gj gj_ava2avd(avd, ava, 66.);
gj gj_ava2da1(da1, ava, 11.);   // AVA↔DA1: 2+9 / 2+9
gj gj_da12ava(ava, da1, 11.);
gj gj_ava2va1(va1, ava, 12.);   // AVA↔VA1: 5+7 / 5+7
gj gj_va12ava(ava, va1, 12.);
gj gj_avb2db1(db1, avb, 15.);   // AVB↔DB1: AVBR→DB01 15 — прямой ход
gj gj_db12avb(avb, db1, 15.);
gj gj_flp2da1(da1, flp, 5.);    // FLP↔DA1: FLPR→DA01 5 — сенсор в мотор
gj gj_da12flp(flp, da1, 5.);

// --- осциллограф --------------------------------------------------------------
monitor mon(simt, ash, flp, aib, ava, avd, avb, da1, va1, db1,
            m_dorsal, m_ventral);
