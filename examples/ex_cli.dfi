zmq_cli() {
    if(this.ctx == undefined) {
        this.ctx = zmq_ctx_new();
        if(!this.ctx) {
            console.error(zmq_errstr());
            return exit(1);
        }
        this.skt = this.ctx.zmq_socket(ZMQ_PAIR);
        if(!this.skt) {
            console.error(zmq_errstr());
            return exit(2);
        }
        if(this.skt.zmq_connect("tcp://localhost:5555") < 0) {
            console.error(zmq_errstr());
            return exit(3);
        }
    }
    if(steady_clock() > this.t) {
        this.t = steady_clock() + 0.1;
        console.println("client sending hello...");
        sent = this.skt.zmq_send("hello");
        rcvd = this.skt.zmq_recv(100, ZMQ_DONTWAIT);
        console.println("client received: ", rcvd);
        if(rcvd.size() == 0) {
            console.println(zmq_errstr());
        }
    }
    return 0;
}

zmq_cli cli_inst();

zmq_sub(id) {
    if(!this.ctx) {
        this.ctx = zmq_ctx_new();
        if(!this.ctx) { console.println(zmq_errstr()); return exit(1); }
        this.skt = this.ctx.zmq_socket(ZMQ_SUB);
        if(!this.skt) { console.println(zmq_errstr()); return exit(2); }
        if(this.skt.zmq_connect("tcp://localhost:5556") < 0) {
            console.println(zmq_errstr()); return exit(3);
        }
        if(this.skt.zmq_setsockopt(ZMQ_SUBSCRIBE, "msg5") < 0)  {
            console.println(zmq_errstr()); return exit(4);
        }
    }
    rcvd = this.skt.zmq_recv(1024);
    console.println("sub client ", id, " received: ", rcvd);
    return rcvd;
}

zmq_sub sbscrbr1(1);
zmq_sub sbscrbr2(2);
zmq_sub sbscrbr3(3);
zmq_sub sbscrbr4(4);
