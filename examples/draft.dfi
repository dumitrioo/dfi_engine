    outer_air_is_fresh, desireable_temperature_house, temperature_outdoor
);

should_initiate_room_window_ventilation should_initiate_room1_window1_ventilation(
    can_window_be_opened, room1_ventilation_required
);
should_initiate_room_window_ventilation should_initiate_room2_window1_ventilation(
    can_window_be_opened, room2_ventilation_required
);
should_initiate_room_window_ventilation should_initiate_room3_window1_ventilation(
    can_window_be_opened, room3_ventilation_required
);

