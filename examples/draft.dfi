// дескрипторы (код, логика узлов) -----------------------------------
is_outer_air_fresh(smoke, organic, co2, dust) {
    return smoke < 35 && organic < 10 && co2 < 15 && dust < 30;
}

can_use_intake_for_ventilation_logic(outer_air_is_fresh, outer_temperature) {
    return outer_air_is_fresh && outer_temperature < 40 && outer_temperature > -5;
}

can_use_window_for_ventilation_logic(outer_air_is_fresh, outer_temperature) {
    return outer_air_is_fresh && outer_temperature > 0;
}

should_cool_room_air(room_temp, desireable_temperature_house) {
    return room_temp > desireable_temperature_house + 3;
}

should_heat_room_air(room_temp, desireable_temperature_house) {
    return room_temp < desireable_temperature_house - 3;
}

can_use_window_for_heating_logic(outer_air_is_fresh, desireable_temperature_house, outer_temp) {
    return outer_air_is_fresh && outer_temp > desireable_temperature_house;
}

can_use_window_for_cooling_logic(outer_air_is_fresh, desireable_temperature_house, outer_temp) {
    return outer_air_is_fresh && outer_temp < desireable_temperature_house;
}

room_ventilation_required(room_gas_level, room_smoke_level, room_organic_level, room_co2_level, room_dust_level) {
    return room_gas_level > 3 || room_smoke_level > 3 || room_organic_level > 5 || room_co2_level > 2 || room_dust_level > 20;
}

can_open_window(outer_air_is_fresh, desireable_temperature_house, outer_temp) {
    return outer_air_is_fresh && outer_temp.between(-5, 30);
}

should_close_room_window(
    outer_air_is_fresh,
    should_heat_room_air, can_use_window_for_heating,
    should_cool_room_air, can_use_window_for_cooling,
    room_ventilation_required, outer_temp, room_temp,
    window_is_opened
) {
    if(!window_is_opened) {
        return false;
    }
    if(!room_ventilation_required) {
        return true;
    }
    return
        !outer_air_is_fresh ||
        (should_heat_room_air && !can_use_window_for_heating) ||
        (should_cool_room_air && !can_use_window_for_cooling);

}

should_open_room_window(can_open_room_window) {
}

should_initiate_room_window_ventilation(
    can_open_window,
    room_ventilation_required,

) {
    return can_open_window && room_ventilation_required;
}


// инстансы рабочих узлов -----------------------------------------
is_outer_air_fresh outer_air_is_fresh(
    air_smoke_outdoor, air_organic_outdoor, air_co2_outdoor, air_dust_outdoor
);
can_use_intake_for_ventilation_logic can_use_intake_for_ventilation(
    outer_air_is_fresh, temperature_outdoor
);
can_use_window_for_ventilation_logic can_use_window_for_ventilation(
    outer_air_is_fresh, temperature_outdoor
);

should_cool_room_air should_cool_room1_air(
    temperature_room1, desireable_temperature_house
);
should_cool_room_air should_cool_room2_air(
    temperature_room2, desireable_temperature_house
);
should_cool_room_air should_cool_room3_air(
    temperature_room3, desireable_temperature_house
);
should_heat_room_air should_heat_room1_air(
    temperature_room1, desireable_temperature_house
);
should_heat_room_air should_heat_room2_air(
    temperature_room2, desireable_temperature_house
);
should_heat_room_air should_heat_room3_air(
    temperature_room3, desireable_temperature_house
);

can_use_window_for_heating_logic can_use_window_for_heating(
    outer_air_is_fresh, desireable_temperature_house, temperature_outdoor
);
can_use_window_for_cooling_logic can_use_window_for_cooling(
    outer_air_is_fresh, desireable_temperature_house, temperature_outdoor
);

room_ventilation_required room1_ventilation_required(
    air_gas_room1, air_smoke_room1, air_organic_room1, air_co2_room1, air_dust_room1
);
room_ventilation_required room2_ventilation_required(
    air_gas_room2, air_smoke_room2, air_organic_room2, air_co2_room2, air_dust_room2
);
room_ventilation_required room3_ventilation_required(
    air_gas_room3, air_smoke_room3, air_organic_room3, air_co2_room3, air_dust_room3
);

