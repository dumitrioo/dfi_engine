// dispatcher_dsc dispatcher();







// Дескриптор: Диспетчер
dispatcher(serviced_call, new_hall_calls) {
    // Инициализация при первом такте (благодаря undefined это работает без if)
    if (this.up_calls == undefined) this.up_calls = [false, false, false, false, false];

    // 1. ЧИСТКА: Если лифт прислал сообщение, что вызов обработан - чистим
    if (serviced_call != undefined) {
        if (serviced_call.dir == "UP") {
            this.up_calls[serviced_call.floor] = false;
        }
        // для DOWN аналогично
    }

    // 2. ЗАПИСЬ: Принимаем новые вызовы с этажей (если кто-то нажал кнопку)
    if (new_hall_calls != undefined) {
        this.up_calls = new_hall_calls; // Перезаписываем битмаску
    }

    // 3. ЛОГИКА: Считаем, кому что назначить (cost function)
    // ... возвращаем массив назначений ...
    return this.up_calls;
}

// Узел лифта (только генерирует serviced_call, не трогает чужое состояние)
elevator_logic(floor, direction, door_state) {
    if (door_state == "OPEN" && this.last_floor != floor) {
        this.last_floor = floor;
        // Лифт не чистит массив диспетчера. Он просто сообщает факт!
        msg = object();
        msg.floor = floor;
        msg.dir = direction;
        return msg; // Это улетит в Диспетчер
    }
    return undefined; // Если ничего не почистили, возвращаем undefined
}
