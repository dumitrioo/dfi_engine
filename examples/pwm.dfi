dbg_printer(val, period) {
    if(steady_clock() > this.t) {
        this.t = steady_clock() + period;
        val.print();
    }
}

pwm_node(frq, duty) {
    clk = steady_clock();
    lvl = sin(clk * frq);
    yield (i64)((clk % duty) / duty <= lvl.abs() ? lvl.sign() : 0);
}


pwm_node pwm(2. * M_PI * 60., .001);
dbg_printer dbg_prn(pwm, .0001);
